<section class="custom-order-band section-spacing">
  <div class="custom-order-band__inner page-width">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <a class="button button--primary" href="{{ section.settings.link }}">{{ section.settings.button_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Custom order band",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not seeing your exact look?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Reserve your custom wig build with a deposit and send your style details at checkout."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Custom Order"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link",
      "default": "/products/custom-wig-deposit"
    }
  ],
  "presets": [
    {
      "name": "Custom order band"
    }
  ]
}
{% endschema %}
