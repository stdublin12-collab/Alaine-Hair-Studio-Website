<footer class="site-footer">
  <div class="site-footer__inner page-width">
    <div>
      <img class="site-footer__logo" src="{{ 'alaine-logo-transparent.png' | asset_url }}" alt="{{ shop.name | escape }}" width="260" height="130" loading="lazy">
      <p>At Alaine Hair Studio, our mission is to create luxury custom wigs and beauty experiences that help every client feel confident, comfortable, and beautifully themselves.</p>
    </div>

    <div class="site-footer__links">
      <a href="/collections/ready-to-wear-wigs">Shop Wigs</a>
      <a href="/collections/services">Services</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/policies/shipping-policy">Shipping</a>
      <a href="/pages/contact">Contact Us</a>
    </div>

    <div class="site-footer__newsletter">
      <h2>Stay in the chair</h2>
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="NewsletterEmail" class="visually-hidden">Email</label>
        <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="Email address" autocorrect="off" autocapitalize="off">
        <button type="submit">Join</button>
      {% endform %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
