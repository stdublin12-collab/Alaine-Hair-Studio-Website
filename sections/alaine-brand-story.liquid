<section class="brand-story section-spacing">
  <div class="page-width brand-story__inner">
    <p>{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="brand-story__copy">
      <span>{{ section.settings.text_one }}</span>
      <span>{{ section.settings.text_two }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "Elegance in every detail"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wigs you can trust, styled around your life"
    },
    {
      "type": "textarea",
      "id": "text_one",
      "label": "Text one",
      "default": "Every custom unit is planned for durability, comfort, and a polished finish you can wear with confidence."
    },
    {
      "type": "textarea",
      "id": "text_two",
      "label": "Text two",
      "default": "It is more than hair. It is convenience, confidence, and a look that feels like you."
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
