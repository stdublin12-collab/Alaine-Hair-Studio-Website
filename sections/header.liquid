<div class="topline">
  <div class="page-width">
    <span>Luxury units made to fit your crown</span>
  </div>
</div>

<div class="promo-marquee" aria-label="Store promotion">
  <div class="promo-marquee__track">
    <span>Ready to Wear Units</span>
    <span>Custom Wig Construction &amp; Reconstruction</span>
    <span>Ready to Wear Units</span>
    <span>Custom Wig Construction &amp; Reconstruction</span>
    <span>Ready to Wear Units</span>
    <span>Custom Wig Construction &amp; Reconstruction</span>
  </div>
</div>

<header class="site-header" data-site-header>
  <div class="site-header__inner page-width">
    <button class="site-header__menu-button" type="button" aria-expanded="false" aria-controls="PrimaryNav" data-menu-button>
      <span class="site-header__menu-lines" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
      <strong>Menu</strong>
    </button>

    <a class="site-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      <img
        src="{{ 'alaine-logo-transparent.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="260"
        height="120"
        loading="eager">
    </a>

    <a class="site-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M7 7h14l-1.4 8.4a2 2 0 0 1-2 1.6H9.2a2 2 0 0 1-2-1.7L6 4H3" />
        <circle cx="9" cy="21" r="1.4" />
        <circle cx="18" cy="21" r="1.4" />
      </svg>
      <span>{{ cart.item_count }}</span>
    </a>
  </div>

  <div class="side-menu-overlay" data-menu-overlay></div>

  <aside id="PrimaryNav" class="side-menu" aria-label="Primary navigation" data-primary-nav>
    <div class="side-menu__head">
      <img src="{{ 'alaine-logo-transparent.png' | asset_url }}" alt="{{ shop.name | escape }}" width="180" height="84" loading="lazy">
      <button class="side-menu__close" type="button" aria-label="Close menu" data-menu-close>
        <span></span>
        <span></span>
      </button>
    </div>

    <nav class="side-menu__nav">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.collections_url }}/all">Ready to Wear Wigs</a>
      <a href="/pages/services">Services</a>
      <a href="/pages/faq">FAQ</a>
    </nav>

    <div class="side-menu__footer">
      <p>Luxury custom wigs and extensions made for your crown.</p>
      <a href="/products/custom-wig-deposit">Start Custom Order</a>
    </div>
  </aside>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
