<section class="faq-preview section-spacing">
  <div class="page-width faq-preview__inner">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <a class="button button--primary" href="{{ section.settings.link }}">{{ section.settings.button_label }}</a>
    </div>

    <div class="faq-preview__list">
      {% for block in section.blocks %}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <p>{{ block.settings.answer }}</p>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ preview",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before You Order"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A few quick answers to help you feel clear before placing a custom wig deposit."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Custom Order"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/products/custom-wig-deposit"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does a custom wig take?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Turnaround depends on the unit and service details. After your deposit, Alaine will confirm timing with you directly."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ preview",
      "blocks": [
        { "type": "faq", "settings": { "question": "How long does a custom wig take?", "answer": "Turnaround depends on the unit and service details. After your deposit, Alaine will confirm timing with you directly." } },
        { "type": "faq", "settings": { "question": "Is the deposit refundable?", "answer": "Deposit policies should be reviewed before checkout. Custom work begins after order details are confirmed." } },
        { "type": "faq", "settings": { "question": "What if I do not know my cap size?", "answer": "Choose the measurement help option on the custom order form and Alaine will guide you." } },
        { "type": "faq", "settings": { "question": "Can I send inspiration photos?", "answer": "Yes. Add an inspiration link or notes when completing the custom wig deposit form." } }
      ]
    }
  ]
}
{% endschema %}
