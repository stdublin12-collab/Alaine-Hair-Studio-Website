<section class="newsletter-strip">
  <div class="page-width newsletter-strip__inner">
    <h2>{{ section.settings.heading }}</h2>
    {% form 'customer', class: 'newsletter-form newsletter-strip__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsletterStripEmail" class="visually-hidden">Email</label>
      <input id="NewsletterStripEmail" type="email" name="contact[email]" placeholder="Email address" autocorrect="off" autocapitalize="off">
      <button type="submit">Subscribe</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Because missing your perfect unit would be tragic. Subscribe now."
    }
  ],
  "presets": [
    {
      "name": "Newsletter strip"
    }
  ]
}
{% endschema %}
