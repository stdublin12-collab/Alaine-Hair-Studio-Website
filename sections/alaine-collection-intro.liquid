<section class="collection-intro">
  <div class="page-width collection-intro__inner">
    <p>{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <div>{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Collection intro",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "Alaine Hair Studio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Wear Wigs"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Shop polished units that are ready for pickup, shipping, or your next install."
    }
  ],
  "presets": [
    {
      "name": "Collection intro"
    }
  ]
}
{% endschema %}
