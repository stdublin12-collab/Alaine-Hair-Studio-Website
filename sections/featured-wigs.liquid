<section class="featured-wigs section-spacing">
  <div class="page-width">
    <div class="section-heading">
      <h2>{{ section.settings.heading }}</h2>
      <a href="{{ section.settings.link }}">View all</a>
    </div>

    <div class="product-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <article class="product-card product-card--placeholder">
            <div class="product-card__media"></div>
            <div class="product-card__body">
              <h3>Ready Unit {{ i }}</h3>
              <p>From $250.00</p>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured wigs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready-to-Wear Units"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "url",
      "id": "link",
      "label": "View all link",
      "default": "/collections/ready-to-wear-wigs"
    }
  ],
  "presets": [
    {
      "name": "Featured wigs"
    }
  ]
}
{% endschema %}
